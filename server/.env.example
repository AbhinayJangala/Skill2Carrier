# OpenRouter API Key for AI resume analysis, skills gap analysis, and opportunity discovery
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Base URL (Optional, defaults to https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Configurable Models (Optional, defaults to openai/gpt-4o-mini)
# OPENROUTER_MODEL_RESUME_ANALYSIS=openai/gpt-4o-mini
# OPENROUTER_MODEL_SKILL_EXTRACTION=openai/gpt-4o-mini
# OPENROUTER_MODEL_CAREER_SUGGESTIONS=openai/gpt-4o-mini
# OPENROUTER_MODEL_OPPORTUNITY_SEARCH=openai/gpt-4o-mini
